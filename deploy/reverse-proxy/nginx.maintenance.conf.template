# ACMS maintenance mode proxy conf (feature-delivery plan §6).
# Copied over nginx.conf during a release transaction so the browser sees a
# clear 503 page instead of a hard outage; nginx is HUP-reloaded, then
# acms-app is stopped. Writes are blocked for the whole maintenance window.

# maintenance marker: ACMS maintenance
# (grep'd by common.sh maintenance_active(); keep the marker phrase intact)

limit_req_zone $binary_remote_addr zone=acms_maint:1m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name acms.miam.home.arpa;

    ssl_certificate     /etc/nginx/tls/acms.crt;
    ssl_certificate_key /etc/nginx/tls/acms.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:ACMS:10m;

    # Same allowlist as the normal conf — internal networks only (plan §12).
    allow 10.0.10.0/24;
    allow 10.0.20.0/24;
    deny  all;

    # Every request returns the maintenance page with 503; no app traffic.
    location / {
        default_type text/html;
        return 503 '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>ACMS — maintenance</title><link rel="stylesheet" href="/ui/static/style.css"></head><body><header class="topbar"><span class="brand">ACMS</span></header><main><h1>Scheduled maintenance</h1><p>ACMS is being updated. This page returns automatically when the release transaction completes.</p></main><footer class="footer"><span>internal only</span></footer></body></html>';
    }
}
# /etc/miam-mcp-gateway/env — example (REAL file: 0600 root:root; never commit real values)
# ACMS REST surface the gateway adapter calls (domain authority).
ACMS_BASE_URL=https://10.0.20.122
ACMS_SERVICE_TOKEN=CHANGE_ME_acms_admin_or_service_token
# CT122 uses a self-signed cert; either pin the CA or (explicit gate) allow insecure:
ACMS_TLS_CA=
ACMS_INSECURE_TLS=1
# Bind + store paths
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=8202
MCP_GATEWAY_TOKENS_PATH=/var/lib/miam-mcp-gateway/tokens.sqlite3
MCP_GATEWAY_AUDIT_PATH=/var/lib/miam-mcp-gateway/activity.sqlite3
MCP_GATEWAY_AUDIT_MIRROR=/var/lib/miam-mcp-gateway/activity.jsonl
# Elevated agent names (comma-separated) granted executive role at the gateway
MCP_GATEWAY_EXECUTIVE_AGENTS=stea-004
# DNS-rebinding Host allowlist (fill once DNS exists; empty = protection disabled)
MCP_GATEWAY_ALLOWED_HOSTS=mcp.miam.home.arpa
# ---- W2 (plan §21/§13/§23) ----
# Server Manager machine API (llm.*/runtime.fleet domain authority; plain HTTP on VM114)
MCP_GATEWAY_LLM_BASE_URL=http://127.0.0.1:8300
MCP_GATEWAY_LLM_TOKEN=CHANGE_ME_server_manager_service_identity
# Shared secret for /internal/* (ACMS dispatch auto-mint + capability card + activity).
# Generate once (e.g. `openssl rand -hex 32`); the SAME value goes into ACMS
# ACMS_MCP_GATEWAY_INTERNAL_TOKEN on CT122. Never print in logs/handoffs.
MCP_GATEWAY_INTERNAL_TOKEN=CHANGE_ME_shared_internal_secret
# Approval-request store (plan §16/§36)
MCP_GATEWAY_APPROVALS_PATH=/var/lib/miam-mcp-gateway/approvals.sqlite3
# ---- W3 (plan §25) ----
# GitHub PAT (authority = the token's own fine-grained permissions; Contents
# read+write needed on the allowlisted repos for the write tools)
MCP_GATEWAY_GITHUB_TOKEN=CHANGE_ME_github_fine_grained_pat
MCP_GATEWAY_GITHUB_REPOS=startupteams/acms-project-framework
# ---- W4 (plan §26) ----
# proxmox.* sandbox domain rides MCP_GATEWAY_LLM_BASE_URL/TOKEN (Server Manager
# is the Proxmox authority; the gateway holds NO PVE credentials).
# SERVER_MANAGER_ARM_SANDBOX_DEFAULT_TTL_HOURS=8   (SM side)
# SERVER_MANAGER_ARM_SANDBOX_MAX_TTL_HOURS=72      (SM side)
